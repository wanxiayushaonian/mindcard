/* pages/workspace/workspace.wxss */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
}

/* Bottom Action Bar */
.bottom-bar {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-around;
  background: var(--color-white);
  border-top: 1rpx solid var(--color-border);
  padding: 12rpx 24rpx;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
}

.bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0;
  min-width: 100rpx;
}

.bar-label {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

/* Grid */
.ws-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  padding: 24rpx 14rpx;
}

.ws-card {
  width: 50%;
  padding: 0 10rpx 20rpx;
  box-sizing: border-box;
}

.ws-card-inner {
  background: var(--color-white);
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
}

.ws-icon-wrap {
  margin-bottom: 8rpx;
}

.ws-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  line-height: 1.3;
}

.ws-count {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.ws-time {
  font-size: 20rpx;
  color: #C0C4CC;
}

/* Add card */
.ws-add {
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #D0D5DD;
  background: transparent;
  box-shadow: none;
  min-height: 200rpx;
}

.ws-add-icon {
  font-size: 48rpx;
  color: #D0D5DD;
  line-height: 1;
  margin-bottom: 8rpx;
}

.ws-add-text {
  font-size: 24rpx;
  color: #999;
}

/* Modal */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.create-modal {
  width: 85%;
  max-height: 85vh;
  background: var(--color-white);
  border-radius: 28rpx;
  padding: 36rpx;
  overflow-y: auto;
}

.modal-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  color: var(--color-text);
  margin-bottom: 28rpx;
}

.modal-input {
  padding: 20rpx 24rpx;
  background: #F5F7FA;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--color-text);
  margin-bottom: 24rpx;
}

.modal-section-label {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
}

/* Icon picker */
.icon-picker {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.icon-option {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F7FA;
  border-radius: 16rpx;
  font-size: 32rpx;
}

.icon-option-active {
  background: rgba(148, 180, 200, 0.2);
  box-shadow: 0 0 0 3rpx var(--color-primary);
}

/* Color picker */
.color-picker {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.color-option {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
}

.color-option-active {
  box-shadow: 0 0 0 4rpx var(--color-white), 0 0 0 7rpx var(--color-primary);
}

.modal-actions {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.modal-cancel {
  background: #F0F2F5;
  color: #666;
}

.modal-confirm {
  background: var(--color-primary);
  color: #fff;
}

/* Confirm dialog */
.confirm-dialog {
  width: 80%;
  max-height: 80vh;
  background: var(--color-white);
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
  overflow-y: auto;
}

.confirm-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 20rpx;
}

.confirm-msg {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  text-align: center;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.confirm-actions {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
}

.confirm-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.confirm-cancel {
  background: #F0F2F5;
  color: #666;
}

.confirm-danger {
  background: #E25D5D;
  color: #fff;
}

/* Join workspace card */
.ws-join {
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #94B4C8;
  background: rgba(148, 180, 200, 0.05);
  box-shadow: none;
  min-height: 200rpx;
}

/* Meta row */
.ws-meta {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

.ws-member-badge {
  font-size: 20rpx;
  color: var(--color-primary);
  background: rgba(148, 180, 200, 0.15);
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.ws-shared-badge {
  font-size: 20rpx;
  color: #E8A87C;
  background: rgba(232, 168, 124, 0.15);
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

/* Section header */
.section-header {
  padding: 16rpx 24rpx 0;
}

.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
}

/* Shared workspace card */
.ws-shared {
  opacity: 0.9;
}

/* Invite code display */
.invite-code-display {
  background: #F5F7FA;
  border-radius: 16rpx;
  padding: 28rpx;
  text-align: center;
  margin-bottom: 28rpx;
}

.invite-code-text {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 12rpx;
  color: var(--color-primary);
  font-family: monospace;
}

