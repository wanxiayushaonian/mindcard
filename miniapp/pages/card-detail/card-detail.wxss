/* pages/card-detail/card-detail.wxss */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
}

/* Detail Card */
.detail-card {
  margin: 24rpx;
  padding: 32rpx;
  background: var(--color-white);
  border-radius: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.detail-card-keywords {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.detail-kw {
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
  font-size: 20rpx;
  color: #fff;
}

.detail-card-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 16rpx;
}

.detail-card-content {
  display: block;
  font-size: 30rpx;
  line-height: 1.8;
  color: var(--color-text);
  margin-bottom: 20rpx;
}

.detail-card-meta {
  display: flex;
  flex-direction: row;
  gap: 24rpx;
}

.detail-meta-item {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.detail-card-badges {
  margin-top: 16rpx;
}

.ai-badge {
  display: flex;
  align-items: center;
  padding: 8rpx 20rpx;
  background: rgba(148, 180, 200, 0.12);
  border-radius: 12rpx;
  font-size: 22rpx;
  color: var(--color-primary-dark);
  align-self: flex-start;
}

/* Bottom Action Bar */
.bottom-bar {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-around;
  background: var(--color-white);
  border-top: 1rpx solid var(--color-border);
  padding: 12rpx 24rpx;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
}

.bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0;
  min-width: 100rpx;
}

.bar-label {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

/* Modal & Confirm Dialog */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.confirm-dialog {
  width: 80%;
  max-height: 80vh;
  background: var(--color-white);
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
  overflow-y: auto;
}

.confirm-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 20rpx;
}

.confirm-msg {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  text-align: center;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.delete-preview {
  background: #FFF8E1;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
}

.preview-loading {
  font-size: 24rpx;
  color: #999;
}

.preview-item {
  display: block;
  font-size: 24rpx;
  color: #E65100;
  line-height: 1.8;
}

.confirm-actions {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
}

.confirm-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.confirm-cancel {
  background: #F0F2F5;
  color: #666;
}

.confirm-danger {
  background: #E25D5D;
  color: #fff;
}

/* Relations Section */
.relations-section {
  margin: 0 24rpx 24rpx;
  padding: 24rpx;
  background: var(--color-white);
  border-radius: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.relations-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.relations-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

.relations-add-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 20rpx;
  background: rgba(148, 180, 200, 0.12);
  border-radius: 20rpx;
  font-size: 22rpx;
  color: var(--color-primary-dark);
}

.relations-empty {
  padding: 24rpx 0;
}

.relations-empty-text {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  text-align: center;
}

.relations-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.relation-card {
  position: relative;
  padding: 20rpx 24rpx;
  background: #F9FAFC;
  border-radius: 16rpx;
}

.relation-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 6rpx;
}

.relation-content {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.relation-remove {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
