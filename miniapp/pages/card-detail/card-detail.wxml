<!--pages/card-detail/card-detail.wxml-->
<navigation-bar title="" back="{{true}}" background="#F9FAFC">
</navigation-bar>

<scroll-view class="scrollarea" scroll-y type="list">
  <!-- Card Display -->
  <view class="detail-card" style="border-left: 8rpx solid {{card.color}};">
    <view class="detail-card-keywords" wx:if="{{card.keywords.length > 0}}">
      <view
        wx:for="{{card.keywords}}"
        wx:key="*this"
        class="detail-kw"
        style="background: {{card.color}};"
      >
        <text>{{item}}</text>
      </view>
    </view>
    <text class="detail-card-title" wx:if="{{card.title}}">{{card.title}}</text>
    <view class="detail-card-content">
      <markdown-render content="{{card.content || ''}}" />
    </view>
    <view class="detail-card-meta">
      <text class="detail-meta-item">创建于 {{card.createdAt}}</text>
      <text class="detail-meta-item" wx:if="{{card.updatedAt}}">更新于 {{card.updatedAt}}</text>
    </view>
    <view class="detail-card-badges" wx:if="{{card.hasAiChat}}" bindtap="onAiBadgeTap">
      <view class="ai-badge">
        <text>AI对话记录 ></text>
      </view>
    </view>
  </view>

  <!-- Card Relations -->
  <view class="relations-section" wx:if="{{relatedCards.length > 0 || !loadingRelations}}">
    <view class="relations-header">
      <text class="relations-title">关联卡片</text>
      <view class="relations-add-btn" bindtap="onAddRelation" wx:if="{{canEditRelations}}">
        <icon name="plus" size="32" color="#7A9BB0" />
        <text>添加关联</text>
      </view>
    </view>
    <view class="relations-empty" wx:if="{{relatedCards.length === 0 && !loadingRelations}}">
      <text class="relations-empty-text">{{canEditRelations ? '暂无关联卡片，点击上方添加' : '暂无关联卡片'}}</text>
    </view>
    <view class="relations-list" wx:if="{{relatedCards.length > 0}}">
      <view
        wx:for="{{relatedCards}}"
        wx:key="id"
        class="relation-card"
        style="border-left: 4rpx solid {{item.color || '#B8D4E3'}};"
        bindtap="onRelationTap"
        data-id="{{item.id}}"
      >
        <text class="relation-title" wx:if="{{item.title}}">{{item.title}}</text>
        <text class="relation-content" overflow="ellipsis" max-lines="2">{{item.preview || item.content}}</text>
        <view class="relation-remove" wx:if="{{canEditRelations}}" catchtap="onRemoveRelation" data-id="{{item.id}}">
          <icon name="x" size="28" color="#999" />
        </view>
      </view>
    </view>
  </view>

  <!-- Bottom spacer for bottom bar -->
  <view style="height: 160rpx;"></view>
</scroll-view>

<!-- Bottom Action Bar -->
<view class="bottom-bar">
  <view class="bar-item" bindtap="onToggleFav">
    <icon name="star" size="44" color="{{card.isFavorite ? '#f0a500' : '#555'}}" />
    <text class="bar-label" style="{{card.isFavorite ? 'color: #f0a500;' : ''}}">收藏</text>
  </view>
  <view class="bar-item" bindtap="onEdit">
    <icon name="pencil" size="44" color="#555" />
    <text class="bar-label">编辑</text>
  </view>
  <view class="bar-item" bindtap="onAiChat">
    <icon name="sparkles" size="44" color="#555" />
    <text class="bar-label">AI对话</text>
  </view>
  <view class="bar-item" bindtap="onDelete">
    <icon name="trash-2" size="44" color="#E25D5D" />
    <text class="bar-label" style="color: #E25D5D;">删除</text>
  </view>
</view>

<!-- Delete Confirm -->
<view class="modal-mask" wx:if="{{showDeleteConfirm}}" bindtap="onHideDelete">
  <view class="confirm-dialog" catchtap="onStopPropagation">
    <text class="confirm-title">确认删除</text>
    <text class="confirm-msg">删除后无法恢复，关联关系和AI对话记录也会同步删除。</text>
    <view class="delete-preview" wx:if="{{deletePreviewLoading}}">
      <text class="preview-loading">正在检查影响范围...</text>
    </view>
    <view class="delete-preview" wx:if="{{deletePreview && !deletePreviewLoading}}">
      <text class="preview-item" wx:if="{{deletePreview.relations > 0}}">将删除 {{deletePreview.relations}} 条关联关系</text>
      <text class="preview-item" wx:if="{{deletePreview.comments > 0}}">将删除 {{deletePreview.comments}} 条评论</text>
      <text class="preview-item" wx:if="{{deletePreview.chats > 0}}">将归档 {{deletePreview.chats}} 个AI对话</text>
    </view>
    <view class="confirm-actions">
      <view class="confirm-btn confirm-cancel" bindtap="onHideDelete">
        <text>取消</text>
      </view>
      <view class="confirm-btn confirm-danger" bindtap="onConfirmDelete">
        <text>删除</text>
      </view>
    </view>
  </view>
</view>

<!-- Card Picker for adding relations -->
<card-picker
  visible="{{showCardPicker}}"
  title="选择关联卡片"
  excludeIds="{{excludeIds}}"
  bind:select="onRelationPickerSelect"
  bind:close="onRelationPickerClose"
/>
