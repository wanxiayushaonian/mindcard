<!--pages/category/category.wxml-->
<navigation-bar title="灵感分类" back="{{true}}" background="#F9FAFC">
  <view slot="right" class="nav-action" bindtap="onBatchMode">
    <text>{{batchMode ? '取消' : '管理'}}</text>
  </view>
</navigation-bar>

<scroll-view class="scrollarea" scroll-y type="list">
  <view class="category-layout">
    <!-- Side navigation -->
    <scroll-view class="side-nav" scroll-y>
      <view
        class="side-item {{activeCategory === 'all' ? 'side-item-active' : ''}}"
        bindtap="onCategorySelect"
        data-key="all"
      >
        <text>全部</text>
        <text class="side-count">{{allCount}}</text>
      </view>
      <view
        wx:for="{{keywordCategories}}"
        wx:key="*this"
        class="side-item {{activeCategory === item ? 'side-item-active' : ''}}"
        bindtap="onCategorySelect"
        data-key="{{item}}"
      >
        <text>{{item}}</text>
        <text class="side-count">{{categoryCounts[item] || 0}}</text>
      </view>
      <view
        class="side-item {{activeCategory === 'temp' ? 'side-item-active' : ''}}"
        bindtap="onCategorySelect"
        data-key="temp"
      >
        <text>临时灵感箱</text>
        <text class="side-count">{{tempCount}}</text>
      </view>
      <view
        class="side-item {{activeCategory === 'fav' ? 'side-item-active' : ''}}"
        bindtap="onCategorySelect"
        data-key="fav"
      >
        <text>收藏夹</text>
        <text class="side-count">{{favCount}}</text>
      </view>
    </scroll-view>

    <!-- Card list -->
    <view class="card-area">
      <view class="card-list" wx:if="{{displayCards.length > 0}}">
        <view
          wx:for="{{displayCards}}"
          wx:key="id"
          class="cat-card"
          style="border-left: 6rpx solid {{item.color}};"
          bindtap="onCardTap"
          data-id="{{item.id}}"
        >
          <view class="cat-card-check" wx:if="{{batchMode}}" catchtap="onCheckCard" data-id="{{item.id}}">
            <view class="check-box {{checkedIds.indexOf(item.id) > -1 ? 'checked' : ''}}">
              <view class="check-mark" wx:if="{{checkedIds.indexOf(item.id) > -1}}"></view>
            </view>
          </view>
          <view class="cat-card-body">
            <view class="card-keywords" wx:if="{{item.keywords.length > 0}}">
              <view
                wx:for="{{item.keywords}}"
                wx:for-item="kw"
                wx:key="*this"
                class="card-kw"
                style="background: {{item.color}};"
              >
                <text>{{kw}}</text>
              </view>
            </view>
            <text class="cat-card-title" wx:if="{{item.title}}">{{item.title}}</text>
            <text class="cat-card-content">{{item.content}}</text>
            <view class="cat-card-footer">
              <text class="cat-card-time">{{item.createdAt}}</text>
              <view class="cat-card-badges">
                <text wx:if="{{item.isTemp}}" class="cat-card-temp">临时</text>
                <text wx:if="{{item.hasAiChat}}" class="cat-card-ai">AI</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="empty-state" wx:if="{{displayCards.length === 0}}">
        <text class="empty-text">该分类暂无卡片</text>
      </view>
    </view>
  </view>

  <!-- Batch actions -->
  <view class="batch-bar" wx:if="{{batchMode && checkedIds.length > 0}}">
    <text class="batch-info">已选 {{checkedIds.length}} 张</text>
    <view class="batch-actions">
      <view class="batch-btn" bindtap="onBatchArchive">
        <text>归档</text>
      </view>
      <view class="batch-btn batch-btn-ai" bindtap="onBatchAi">
        <text>AI优化</text>
      </view>
      <view class="batch-btn batch-btn-danger" bindtap="onBatchDelete">
        <text>删除</text>
      </view>
    </view>
  </view>
</scroll-view>
