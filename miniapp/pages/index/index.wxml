<!--pages/index/index.wxml-->
<navigation-bar title="{{workspaceName}}" back="{{true}}" background="#F9FAFC">
</navigation-bar>

<scroll-view
  class="scrollarea"
  scroll-y
  type="list"
  refresher-enabled="{{true}}"
  refresher-triggered="{{refreshing}}"
  bindrefresherrefresh="onRefresh"
>
  <!-- Keyword filter bar -->
  <scroll-view class="tag-bar" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="tag-bar-inner">
      <view
        class="tag-item {{selectedTag === '全部' ? 'tag-active' : ''}}"
        bindtap="onTagSelect"
        data-tag="全部"
      >
        <text>全部</text>
      </view>
      <view
        wx:for="{{allKeywords}}"
        wx:key="*this"
        class="tag-item {{selectedTag === item ? 'tag-active' : ''}}"
        bindtap="onTagSelect"
        data-tag="{{item}}"
      >
        <text>{{item}}</text>
      </view>
      <view
        class="tag-item {{selectedTag === '临时灵感箱' ? 'tag-active' : ''}}"
        bindtap="onTagSelect"
        data-tag="临时灵感箱"
      >
        <text>临时灵感箱</text>
      </view>
    </view>
  </scroll-view>

  <!-- Stats bar -->
  <view class="stats-bar">
    <text class="stats-text">{{filteredCards.length}} 张灵感卡片</text>
    <view class="stats-right">
      <view class="stats-fav" bindtap="onTagSelect" data-tag="收藏">
        <icon name="star" size="14" color="#f0a500" />
        <text class="stats-fav-text">{{favCount}}</text>
      </view>
    </view>
  </view>

  <!-- Empty state -->
  <view class="empty-state" wx:if="{{filteredCards.length === 0}}">
    <view class="empty-icon">💡</view>
    <text class="empty-text">还没有灵感卡片</text>
    <text class="empty-hint">点击右下角按钮开始记录</text>
  </view>

  <!-- Waterfall card layout -->
  <view class="waterfall" wx:if="{{filteredCards.length > 0}}">
    <view class="waterfall-col">
      <view
        wx:for="{{leftCards}}"
        wx:key="id"
        class="card"
        style="border-left: 6rpx solid {{item.color}};"
        bindtap="onCardTap"
        bindlongpress="onCardLongPress"
        data-id="{{item.id}}"
      >
        <view class="card-keywords" wx:if="{{item.keywords.length > 0}}">
          <view
            wx:for="{{item.keywords}}"
            wx:for-item="kw"
            wx:key="*this"
            class="card-kw"
            style="background: {{item.color}};"
          >
            <text>{{kw}}</text>
          </view>
        </view>
        <text class="card-title" wx:if="{{item.title}}">{{item.title}}</text>
        <text class="card-content-text">{{item.preview}}</text>
        <view class="card-footer">
          <text class="card-time">{{item.createdAt}}</text>
          <view class="card-badges">
            <text wx:if="{{item.hasAiChat}}" class="card-ai-badge">AI</text>
            <icon wx:if="{{item.isFavorite}}" name="star" size="12" color="#f0a500" />
          </view>
        </view>
      </view>
    </view>
    <view class="waterfall-col">
      <view
        wx:for="{{rightCards}}"
        wx:key="id"
        class="card"
        style="border-left: 6rpx solid {{item.color}};"
        bindtap="onCardTap"
        bindlongpress="onCardLongPress"
        data-id="{{item.id}}"
      >
        <view class="card-keywords" wx:if="{{item.keywords.length > 0}}">
          <view
            wx:for="{{item.keywords}}"
            wx:for-item="kw"
            wx:key="*this"
            class="card-kw"
            style="background: {{item.color}};"
          >
            <text>{{kw}}</text>
          </view>
        </view>
        <text class="card-title" wx:if="{{item.title}}">{{item.title}}</text>
        <text class="card-content-text">{{item.preview}}</text>
        <view class="card-footer">
          <text class="card-time">{{item.createdAt}}</text>
          <view class="card-badges">
            <text wx:if="{{item.hasAiChat}}" class="card-ai-badge">AI</text>
            <icon wx:if="{{item.isFavorite}}" name="star" size="12" color="#f0a500" />
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- Bottom spacer for bottom bar -->
  <view style="height: 160rpx;"></view>
</scroll-view>

<!-- Bottom Action Bar -->
<view class="bottom-bar">
  <view class="bar-item" bindtap="onWalk">
    <icon name="sparkles" size="22" color="#555" />
    <text class="bar-label">漫游</text>
  </view>
  <view class="bar-item bar-item-center" bindtap="onFabTap">
    <icon name="plus" size="26" color="#fff" />
  </view>
  <view class="bar-item" bindtap="onSearch">
    <icon name="search" size="22" color="#555" />
    <text class="bar-label">搜索</text>
  </view>
  <view class="bar-item" bindtap="onProfile">
    <icon name="settings" size="22" color="#555" />
    <text class="bar-label">设置</text>
  </view>
</view>

<!-- Flash Note Modal -->
<view class="modal-mask" wx:if="{{showFlashModal}}" bindtap="onModalClose">
  <view class="flash-modal" catchtap="onStopPropagation">
    <view class="flash-modal-header">
      <text class="flash-modal-title">极速闪记</text>
      <view class="flash-close" bindtap="onModalClose">
        <icon name="x" size="18" color="#999" />
      </view>
    </view>
    <view class="flash-modal-body">
      <textarea
        class="flash-input"
        placeholder="输入你的灵感..."
        placeholder-style="color: #C0C4CC;"
        value="{{flashContent}}"
        bindinput="onFlashInput"
        maxlength="-1"
        auto-height
        adjust-position="{{true}}"
        style="max-height: 300rpx;"
      />
      <!-- Keywords in flash modal -->
      <view class="flash-keywords">
        <view class="flash-keyword-row">
          <input
            class="flash-keyword-input"
            placeholder="添加关键字..."
            placeholder-style="color: #C0C4CC;"
            value="{{flashKeywordInput}}"
            bindinput="onFlashKeywordInput"
            bindconfirm="onFlashAddKeyword"
          />
          <view class="flash-keyword-add" bindtap="onFlashAddKeyword">
            <text>+</text>
          </view>
        </view>
        <view class="flash-keyword-list" wx:if="{{flashKeywords.length > 0}}">
          <view
            wx:for="{{flashKeywords}}"
            wx:key="*this"
            class="flash-kw-pill"
          >
            <text>{{item}}</text>
            <text class="flash-kw-remove" bindtap="onFlashRemoveKeyword" data-kw="{{item}}">x</text>
          </view>
        </view>
        <view class="flash-suggest" wx:if="{{flashSuggestedKeywords.length > 0}}">
          <view
            wx:for="{{flashSuggestedKeywords}}"
            wx:key="*this"
            class="flash-suggest-pill"
            bindtap="onFlashSuggestKeyword"
            data-kw="{{item}}"
          >
            <text>{{item}}</text>
          </view>
        </view>
      </view>
    </view>
    <view class="flash-actions">
      <view class="flash-actions-right">
        <view class="flash-ai-btn" bindtap="onAiPolish">
          <text>AI润色</text>
        </view>
        <view class="flash-ai-btn" bindtap="onAiSupplement">
          <text>AI补充</text>
        </view>
        <view class="flash-save-btn" bindtap="onFlashSave">
          <text>保存</text>
        </view>
      </view>
    </view>
    <text class="flash-hint">1秒闪记，AI自动提取关键字</text>
  </view>
</view>

<!-- Inspiration Walk Modal -->
<view class="modal-mask" wx:if="{{showWalkModal}}" bindtap="onWalkClose">
  <view class="walk-modal" catchtap="onStopPropagation">
    <view class="walk-modal-header">
      <text class="walk-modal-title">灵感漫游</text>
      <view class="walk-close" bindtap="onWalkClose">
        <icon name="x" size="18" color="#999" />
      </view>
    </view>
    <view class="walk-modal-body">
      <view class="walk-card" style="border-left: 6rpx solid {{walkCard.color}};">
        <view class="card-keywords" wx:if="{{walkCard.keywords.length > 0}}">
          <view
            wx:for="{{walkCard.keywords}}"
            wx:for-item="kw"
            wx:key="*this"
            class="card-kw"
            style="background: {{walkCard.color}};"
          >
            <text>{{kw}}</text>
          </view>
        </view>
        <text class="walk-card-title" wx:if="{{walkCard.title}}">{{walkCard.title}}</text>
        <text class="walk-card-content">{{walkCard.preview}}</text>
        <view class="walk-card-footer">
          <text class="walk-card-time">{{walkCard.createdAt}}</text>
          <text wx:if="{{walkCard.hasAiChat}}" class="walk-card-ai">AI对话</text>
        </view>
      </view>
    </view>
    <view class="walk-actions">
      <view class="walk-btn walk-btn-secondary" bindtap="onWalkRefresh">
        <text>再换一张</text>
      </view>
      <view class="walk-btn walk-btn-primary" bindtap="onWalkDetail">
        <text>查看详情</text>
      </view>
    </view>
  </view>
</view>
