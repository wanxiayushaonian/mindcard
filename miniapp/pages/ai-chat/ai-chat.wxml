<!--pages/ai-chat/ai-chat.wxml-->
<navigation-bar title="AI灵感助手" back="{{true}}" background="#F9FAFC">
</navigation-bar>

<scroll-view class="scrollarea" scroll-y scroll-into-view="{{scrollTarget}}">
  <!-- Context hint -->
  <view class="context-bar" wx:if="{{contextCard}}">
    <view class="context-inner">
      <view class="context-label">当前上下文</view>
      <text class="context-content" overflow="ellipsis" max-lines="2">{{contextCard.content}}</text>
    </view>
    <view class="context-change" bindtap="onChangeContext">
      <text>更换</text>
    </view>
  </view>

  <!-- Chat messages -->
  <view class="chat-list">
    <view
      wx:for="{{messages}}"
      wx:key="uid"
      id="msg-{{item.id}}"
    >
      <!-- User message -->
      <view class="msg msg-user" wx:if="{{item.role === 'user'}}" bindlongpress="onMsgLongPress" data-msg-id="{{item.id}}">
        <view class="msg-bubble msg-bubble-user">
          <text>{{item.content}}</text>
        </view>
        <text class="msg-time">{{item.time}}</text>
      </view>

      <!-- AI message -->
      <view class="msg msg-ai" wx:if="{{item.role === 'ai'}}" bindlongpress="onMsgLongPress" data-msg-id="{{item.id}}">
        <view class="msg-avatar">AI</view>
        <view class="msg-body">
          <!-- Error message -->
          <view wx:if="{{item.isError}}" class="msg-bubble msg-bubble-error">
            <text class="error-text">{{item.content}}</text>
          </view>
          <!-- Normal AI message -->
          <view wx:else class="msg-bubble msg-bubble-ai">
            <markdown-render content="{{item.content || ''}}" />
          </view>
          <!-- Source cards (RAG mode) -->
          <view class="source-cards" wx:if="{{item.sources && item.sources.length > 0}}">
            <text class="source-label">参考来源</text>
            <view
              wx:for="{{item.sources}}"
              wx:for-item="src"
              wx:key="id"
              class="source-card"
              bindtap="onSourceTap"
              data-id="{{src.id}}"
            >
              <text class="source-title">{{src.title || '未命名卡片'}}</text>
              <text class="source-content" overflow="ellipsis" max-lines="2">{{src.content}}</text>
            </view>
          </view>
          <!-- Web search results -->
          <view class="web-search-results" wx:if="{{item.webSearchResults && item.webSearchResults.length > 0}}">
            <text class="source-label">网络搜索</text>
            <view
              wx:for="{{item.webSearchResults}}"
              wx:for-item="sr"
              wx:key="url"
              class="web-result-item"
            >
              <text class="web-result-title">{{sr.title}}</text>
              <text class="web-result-snippet" overflow="ellipsis" max-lines="2">{{sr.snippet}}</text>
            </view>
          </view>
          <view class="msg-actions">
            <view class="msg-action-btn" bindtap="onApplyToCard" data-msg-id="{{item.id}}">
              <text>应用到卡片</text>
            </view>
          </view>
          <text class="msg-time">{{item.time}}</text>
        </view>
      </view>
    </view>

    <!-- Loading indicator -->
    <view class="msg msg-ai" wx:if="{{isLoading}}">
      <view class="msg-avatar">AI</view>
      <view class="msg-body">
        <view class="msg-bubble msg-bubble-ai msg-loading">
          <view class="loading-dots">
            <view class="dot"></view>
            <view class="dot"></view>
            <view class="dot"></view>
          </view>
          <text>AI思考中...</text>
        </view>
      </view>
    </view>
  </view>

  <view id="scroll-bottom" style="height: 20rpx;"></view>
</scroll-view>

<!-- Input area -->
<view class="input-area">
  <view class="quick-prompts">
    <view class="quick-btn" bindtap="onQuickPrompt" data-prompt="完善这个灵感">
      <text>完善灵感</text>
    </view>
    <view class="quick-btn" bindtap="onQuickPrompt" data-prompt="拓展思路方向">
      <text>拓展思路</text>
    </view>
    <view class="quick-btn" bindtap="onQuickPrompt" data-prompt="润色优化内容">
      <text>润色内容</text>
    </view>
  </view>
  <view class="input-row">
    <textarea
      class="chat-input"
      placeholder="基于卡片知识提问..."
      placeholder-style="color: #C0C4CC;"
      value="{{inputText}}"
      bindinput="onInput"
      bindconfirm="onSend"
      confirm-type="send"
      auto-height
      maxlength="-1"
      style="max-height: 160rpx;"
    />
    <view wx:if="{{isLoading}}" class="send-btn send-btn-stop" bindtap="onStopStream">
      <text>停止</text>
    </view>
    <view wx:else class="send-btn {{inputText.trim() ? 'send-btn-active' : ''}}" bindtap="onSend">
      <text>发送</text>
    </view>
  </view>
</view>

<!-- Card Picker for context switch -->
<card-picker
  visible="{{showCardPicker}}"
  title="选择上下文卡片"
  excludeIds="{{[]}}"
  bind:select="onContextPickerSelect"
  bind:close="onContextPickerClose"
/>
