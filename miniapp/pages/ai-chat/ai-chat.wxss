/* pages/ai-chat/ai-chat.wxss */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
}

.nav-icon-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-icon-text {
  font-size: 36rpx;
  color: #666;
  line-height: 1;
}

/* Context bar */
.context-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin: 16rpx 24rpx;
  padding: 20rpx;
  background: rgba(148, 180, 200, 0.08);
  border-radius: 16rpx;
  gap: 16rpx;
}

.context-inner {
  flex: 1;
}

.context-label {
  font-size: 20rpx;
  color: var(--color-primary-dark);
  margin-bottom: 6rpx;
}

.context-content {
  font-size: 24rpx;
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.context-change {
  padding: 8rpx 16rpx;
  background: var(--color-primary);
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #fff;
  flex-shrink: 0;
}

/* Chat list */
.chat-list {
  padding: 0 24rpx;
}

.msg {
  margin-bottom: 28rpx;
}

.msg-user {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.msg-ai {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  align-items: flex-start;
}

.msg-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #fff;
  font-weight: 700;
  flex-shrink: 0;
}

.msg-body {
  flex: 1;
  max-width: 80%;
}

.msg-bubble {
  padding: 24rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.7;
}

.msg-bubble-user {
  background: var(--color-primary);
  color: #fff;
  border-top-right-radius: 4rpx;
}

.msg-bubble-ai {
  background: var(--color-white);
  color: var(--color-text);
  border-top-left-radius: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.msg-actions {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin-top: 12rpx;
}

.msg-action-btn {
  padding: 8rpx 20rpx;
  background: rgba(148, 180, 200, 0.1);
  border-radius: 12rpx;
  font-size: 22rpx;
  color: var(--color-primary-dark);
}

.msg-action-disabled {
  opacity: 0.5;
}

.msg-time {
  font-size: 20rpx;
  color: #C0C4CC;
  margin-top: 8rpx;
}

/* Loading */
.msg-loading {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

.loading-dots {
  display: flex;
  flex-direction: row;
  gap: 8rpx;
}

.loading-dots .dot {
  width: 10rpx;
  height: 10rpx;
  background: var(--color-primary);
  border-radius: 50%;
  opacity: 0.4;
}

/* Input area */
.input-area {
  background: var(--color-white);
  border-top: 1rpx solid var(--color-border);
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.quick-prompts {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.quick-btn {
  padding: 8rpx 20rpx;
  background: rgba(148, 180, 200, 0.1);
  border-radius: 20rpx;
  font-size: 22rpx;
  color: var(--color-primary-dark);
}

.input-row {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  align-items: center;
}

.chat-input {
  flex: 1;
  padding: 16rpx 24rpx;
  background: #F5F7FA;
  border-radius: 24rpx;
  font-size: 28rpx;
  color: var(--color-text);
}

.send-btn {
  padding: 16rpx 32rpx;
  background: #E0E5EA;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #999;
}

.send-btn-active {
  background: var(--color-primary);
  color: #fff;
}
