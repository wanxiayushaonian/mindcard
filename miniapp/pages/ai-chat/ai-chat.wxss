/* pages/ai-chat/ai-chat.wxss */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
}

.streaming-text {
  font-size: 28rpx;
  line-height: 1.7;
  color: #2C3E50;
  white-space: pre-wrap;
}

/* Source cards */
.source-cards {
  margin-top: 16rpx;
  padding: 16rpx;
  background: rgba(148, 180, 200, 0.06);
  border-radius: 12rpx;
}

.source-label {
  font-size: 20rpx;
  color: #8E9AAF;
  margin-bottom: 12rpx;
  display: block;
}

.source-card {
  padding: 12rpx 16rpx;
  background: #fff;
  border-radius: 10rpx;
  margin-bottom: 8rpx;
  border-left: 4rpx solid var(--color-primary, #7A9BB0);
}

.source-card:last-child {
  margin-bottom: 0;
}

.source-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #2C3E50;
  display: block;
  margin-bottom: 4rpx;
}

.source-content {
  font-size: 22rpx;
  color: #8E9AAF;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Context bar */
.context-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin: 16rpx 24rpx;
  padding: 20rpx;
  background: rgba(148, 180, 200, 0.08);
  border-radius: 16rpx;
  gap: 16rpx;
}

.context-inner {
  flex: 1;
}

.context-label {
  font-size: 20rpx;
  color: var(--color-primary-dark);
  margin-bottom: 6rpx;
}

.context-content {
  font-size: 24rpx;
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
}

.context-change {
  padding: 8rpx 16rpx;
  background: var(--color-primary);
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #fff;
  flex-shrink: 0;
}

/* Scroll area */
.scrollarea {
  flex: 1;
  overflow: hidden;
}

/* Chat list */
.chat-list {
  padding: 0 24rpx;
}

.msg {
  margin-bottom: 28rpx;
}

.msg-user {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.msg-ai {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  align-items: flex-start;
}

.msg-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #fff;
  font-weight: 700;
  flex-shrink: 0;
}

.msg-body {
  flex: 1;
  max-width: 80%;
}

.msg-bubble {
  padding: 24rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.7;
}

.msg-bubble-user {
  background: var(--color-primary);
  color: #fff;
  border-top-right-radius: 4rpx;
}

.msg-bubble-ai {
  background: var(--color-white);
  color: var(--color-text);
  border-top-left-radius: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.msg-bubble-error {
  background: #FFF5F5;
  border-left: 6rpx solid #E25D5D;
  border-top-left-radius: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.error-text {
  font-size: 28rpx;
  color: #C0392B;
  line-height: 1.7;
}

.ai-content-text {
  font-size: 28rpx;
  color: var(--color-text);
  line-height: 1.7;
  word-break: break-all;
  white-space: pre-wrap;
}

.msg-actions {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin-top: 12rpx;
}

.msg-action-btn {
  padding: 8rpx 20rpx;
  background: rgba(148, 180, 200, 0.1);
  border-radius: 12rpx;
  font-size: 22rpx;
  color: var(--color-primary-dark);
}

.msg-time {
  font-size: 20rpx;
  color: #C0C4CC;
  margin-top: 8rpx;
}

/* Input area */

/* Loading */
.msg-loading {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

.loading-dots {
  display: flex;
  flex-direction: row;
  gap: 8rpx;
}

.loading-dots .dot {
  width: 10rpx;
  height: 10rpx;
  background: var(--color-primary);
  border-radius: 50%;
  animation: dotBounce 1.4s infinite ease-in-out;
}
.loading-dots .dot:nth-child(1) { animation-delay: 0s; }
.loading-dots .dot:nth-child(2) { animation-delay: 0.16s; }
.loading-dots .dot:nth-child(3) { animation-delay: 0.32s; }

@keyframes dotBounce {
  0%, 80%, 100% { transform: translateY(0); opacity: 0.4; }
  40% { transform: translateY(-12rpx); opacity: 1; }
}

/* Input area */
.input-area {
  background: var(--color-white);
  border-top: 1rpx solid var(--color-border);
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.quick-prompts {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.quick-btn {
  padding: 8rpx 20rpx;
  background: rgba(148, 180, 200, 0.1);
  border-radius: 20rpx;
  font-size: 22rpx;
  color: var(--color-primary-dark);
}

.input-row {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  align-items: center;
}

.chat-input {
  flex: 1;
  padding: 16rpx 24rpx;
  background: #F5F7FA;
  border-radius: 24rpx;
  font-size: 28rpx;
  color: var(--color-text);
}

.send-btn {
  padding: 16rpx 32rpx;
  background: #E0E5EA;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #999;
}

.send-btn-active {
  background: var(--color-primary);
  color: #fff;
}

.send-btn-stop {
  background: #e74c3c;
  color: #fff;
}

/* Web search results */
.web-search-results {
  margin-top: 12rpx;
  padding: 0 24rpx;
}

.web-result-item {
  background: #F5F5F5;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 8rpx;
}

.web-result-title {
  display: block;
  font-size: 26rpx;
  color: #1565C0;
  margin-bottom: 6rpx;
}

.web-result-snippet {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

/* History overlay */
.nav-history-btn {
  padding: 8rpx 16rpx;
  font-size: 26rpx;
  color: var(--color-primary-dark);
}

.history-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 1000;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s;
}

.history-overlay-show {
  opacity: 1;
  pointer-events: auto;
}

.history-panel {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  max-height: 65vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
}

.history-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 32rpx;
  border-bottom: 1rpx solid #F0F2F5;
}

.history-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2C3E50;
}

.history-close {
  padding: 8rpx 16rpx;
  font-size: 26rpx;
  color: #8E9AAF;
}

.history-list {
  flex: 1;
  overflow-y: auto;
  padding: 0 32rpx;
}

.history-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F5F6F8;
}

.history-item:active {
  background: #F8F9FB;
  margin: 0 -32rpx;
  padding-left: 32rpx;
  padding-right: 32rpx;
}

.history-item-top {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.history-item-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #2C3E50;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-item-count {
  font-size: 22rpx;
  color: #C0C4CC;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.history-item-preview {
  display: block;
  font-size: 24rpx;
  color: #8E9AAF;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-item-time {
  font-size: 20rpx;
  color: #C0C4CC;
}

.history-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx;
  font-size: 26rpx;
  color: #C0C4CC;
}
