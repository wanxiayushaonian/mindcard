/* pages/profile/profile.wxss */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
}

.scrollarea {
  flex: 1;
}

/* User Card */
.user-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 32rpx;
  margin: 24rpx;
  background: var(--color-white);
  border-radius: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.user-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.user-info {
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 6rpx;
}

.user-sub {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* Section */
.section {
  margin: 0 24rpx 24rpx;
}

.section-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

/* Stats Grid */
.stats-grid {
  display: flex;
  flex-direction: row;
  background: var(--color-white);
  border-radius: 24rpx;
  padding: 32rpx 0;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-number {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.stats-note {
  margin-top: 12rpx;
  padding: 0 8rpx;
}

.stats-note text {
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

/* Settings List */
.settings-list {
  background: var(--color-white);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.settings-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.settings-item:last-child {
  border-bottom: none;
}

.settings-left {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.settings-icon-wrap {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.settings-text {
  font-size: 28rpx;
  color: var(--color-text);
}

.danger-text {
  color: #e74c3c;
}

.settings-right {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

.settings-value {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.settings-arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid #C0C4CC;
  border-right: 3rpx solid #C0C4CC;
  transform: rotate(45deg);
}

/* Color Picker */
.color-list {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
}

.color-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid transparent;
}

.color-dot-active {
  border: 4rpx solid #fff;
  box-shadow: 0 0 0 3rpx var(--color-primary);
}

/* Switch */
.switch-track {
  width: 84rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: #DCDFE6;
  display: flex;
  align-items: center;
  padding: 4rpx;
  transition: background 0.2s;
}

.switch-on {
  background: var(--color-primary);
}

.switch-thumb {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
  transition: transform 0.2s;
}

.switch-on .switch-thumb {
  transform: translateX(36rpx);
}

/* Footer */
.profile-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 24rpx;
}

.footer-text {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.footer-subtext {
  font-size: 20rpx;
  color: #C0C4CC;
}
