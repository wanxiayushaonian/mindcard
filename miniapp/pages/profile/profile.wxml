<!--pages/profile/profile.wxml-->
<navigation-bar title="个人中心" back="{{true}}" background="#F9FAFC">
</navigation-bar>

<scroll-view class="scrollarea" scroll-y type="list">
  <!-- Stats Overview -->
  <view class="stats-grid">
    <view class="stat-item">
      <text class="stat-number">{{stats.totalCards}}</text>
      <text class="stat-label">灵感卡片</text>
    </view>
    <view class="stat-item">
      <text class="stat-number">{{stats.weeklyNew}}</text>
      <text class="stat-label">本周新增</text>
    </view>
    <view class="stat-item">
      <text class="stat-number">{{stats.favorites}}</text>
      <text class="stat-label">收藏数</text>
    </view>
    <view class="stat-item">
      <text class="stat-number">{{stats.tempCards}}</text>
      <text class="stat-label">临时灵感</text>
    </view>
  </view>

  <!-- Data Management -->
  <view class="settings-section">
    <text class="settings-section-title">数据管理</text>
    <view class="settings-list">
      <view class="settings-item" bindtap="onBackup">
        <view class="settings-left">
          <view class="settings-icon-wrap"><icon name="cloud" size="18" color="#555" /></view>
          <text class="settings-text">数据备份</text>
        </view>
        <view class="settings-arrow"></view>
      </view>
    </view>
  </view>

  <!-- Logout -->
  <view class="settings-section">
    <view class="settings-list">
      <view class="settings-item" bindtap="onLogout">
        <view class="settings-left">
          <view class="settings-icon-wrap"><icon name="log-out" size="18" color="#e74c3c" /></view>
          <text class="settings-text danger-text">退出登录</text>
        </view>
      </view>
    </view>
  </view>

  <!-- Footer -->
  <view class="profile-footer">
    <text class="footer-text">思维灵感卡片 v1.0.0</text>
    <text class="footer-subtext">基于微信小程序原生开发</text>
  </view>
</scroll-view>
