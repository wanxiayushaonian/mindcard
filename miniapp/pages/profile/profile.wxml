<!--pages/profile/profile.wxml-->
<navigation-bar title="我的" back="{{false}}" background="#F9FAFC">
</navigation-bar>

<scroll-view class="scrollarea" scroll-y type="list">

  <!-- User Info -->
  <view class="user-card">
    <view class="user-avatar">
      <icon name="user" size="56" color="#fff" />
    </view>
    <view class="user-info">
      <text class="user-name">{{user.nickName || '未登录'}}</text>
      <text class="user-sub">{{stats.totalWorkspaces}} 个灵感空间</text>
    </view>
  </view>

  <!-- Global Stats -->
  <view class="section">
    <text class="section-title">全局统计</text>
    <view class="stats-grid">
      <view class="stat-item">
        <text class="stat-number">{{loadingStats ? '—' : stats.totalWorkspaces}}</text>
        <text class="stat-label">灵感空间</text>
      </view>
      <view class="stat-item">
        <text class="stat-number">{{loadingStats ? '—' : stats.totalCards}}</text>
        <text class="stat-label">卡片总数</text>
      </view>
      <view class="stat-item">
        <text class="stat-number">{{loadingStats ? '—' : stats.currentWeeklyNew}}</text>
        <text class="stat-label">本周新增</text>
      </view>
      <view class="stat-item">
        <text class="stat-number">{{loadingStats ? '—' : stats.currentFavorites}}</text>
        <text class="stat-label">收藏卡片</text>
      </view>
    </view>
    <view class="stats-note" wx:if="{{stats.currentWorkspaceName}}">
      <text>本周新增与收藏基于当前空间「{{stats.currentWorkspaceName}}」</text>
    </view>
  </view>

  <!-- Global Settings -->
  <view class="section">
    <text class="section-title">全局设置</text>
    <view class="settings-list">
      <!-- Walk sensitivity -->
      <view class="settings-item" bindtap="onSensitivityTap">
        <view class="settings-left">
          <view class="settings-icon-wrap"><icon name="sparkles" size="36" color="#555" /></view>
          <text class="settings-text">摇一摇灵敏度</text>
        </view>
        <view class="settings-right">
          <text class="settings-value">{{walkSensitivity}}</text>
          <view class="settings-arrow"></view>
        </view>
      </view>
      <!-- Default color -->
      <view class="settings-item">
        <view class="settings-left">
          <view class="settings-icon-wrap"><icon name="palette" size="36" color="#555" /></view>
          <text class="settings-text">默认卡片配色</text>
        </view>
        <view class="color-list">
          <view
            wx:for="{{colors}}"
            wx:key="*this"
            class="color-dot {{defaultColor === item ? 'color-dot-active' : ''}}"
            style="background: {{item}};"
            bindtap="onColorSelect"
            data-color="{{item}}"
          ></view>
        </view>
      </view>
      <!-- Auto extract keywords -->
      <view class="settings-item">
        <view class="settings-left">
          <view class="settings-icon-wrap"><icon name="tag" size="36" color="#555" /></view>
          <text class="settings-text">闪记自动提取关键字</text>
        </view>
        <view class="switch-track {{autoExtract ? 'switch-on' : ''}}" bindtap="onAutoExtractToggle">
          <view class="switch-thumb"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- Data Management -->
  <view class="section">
    <text class="section-title">数据管理</text>
    <view class="settings-list">
      <view class="settings-item" bindtap="onExportCurrent">
        <view class="settings-left">
          <view class="settings-icon-wrap"><icon name="cloud" size="36" color="#555" /></view>
          <text class="settings-text">导出当前空间</text>
        </view>
        <view class="settings-arrow"></view>
      </view>
      <view class="settings-item" bindtap="onExportAll">
        <view class="settings-left">
          <view class="settings-icon-wrap"><icon name="cloud" size="36" color="#555" /></view>
          <text class="settings-text">导出全部空间</text>
        </view>
        <view class="settings-arrow"></view>
      </view>
    </view>
  </view>

  <!-- Account -->
  <view class="section">
    <view class="settings-list">
      <view class="settings-item" bindtap="onLogout">
        <view class="settings-left">
          <view class="settings-icon-wrap"><icon name="log-out" size="36" color="#e74c3c" /></view>
          <text class="settings-text danger-text">退出登录</text>
        </view>
      </view>
    </view>
  </view>

  <!-- Footer -->
  <view class="profile-footer">
    <text class="footer-text">思维灵感卡片 v1.0.0</text>
    <text class="footer-subtext">基于微信小程序原生开发</text>
  </view>

  <!-- Bottom spacer for tab bar -->
  <view style="height: 160rpx;"></view>
</scroll-view>
