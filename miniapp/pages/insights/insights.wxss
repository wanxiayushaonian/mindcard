/* pages/insights/insights.wxss */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F9FAFC;
}

.loading-state {
  text-align: center;
  padding: 120rpx 0;
  font-size: 28rpx;
  color: #8E9AAF;
}

.insights-content {
  padding: 24rpx;
}

.section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2C3E50;
  margin-bottom: 16rpx;
  display: block;
}

.theme-list {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
}

.theme-tag {
  padding: 8rpx 24rpx;
  background: rgba(148, 180, 200, 0.15);
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #5A7D9A;
}

.trends-card {
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.trends-text {
  font-size: 28rpx;
  line-height: 1.7;
  color: #444;
}

.insight-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.insight-item {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.insight-icon {
  font-size: 28rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.insight-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #444;
}

.empty-state {
  text-align: center;
  padding: 80rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.refresh-btn {
  margin: 40rpx auto;
  padding: 20rpx 60rpx;
  background: var(--color-primary, #7A9BB0);
  border-radius: 32rpx;
  text-align: center;
  font-size: 28rpx;
  color: #fff;
}
