.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-around;
  background: var(--color-white, #fff);
  border-top: 1rpx solid var(--color-border, #E8ECF1);
  padding: 8rpx 0;
  padding-bottom: calc(8rpx + env(safe-area-inset-bottom));
  z-index: 999;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  padding: 6rpx 0;
}

.tab-icon-wrap {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-label {
  font-size: 20rpx;
  color: var(--color-text-secondary, #8E9AAF);
  margin-top: 4rpx;
}

.tab-active .tab-label {
  color: var(--color-primary-dark, #7A9BB0);
  font-weight: 600;
}
