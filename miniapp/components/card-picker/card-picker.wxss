/* components/card-picker/card-picker.wxss */
.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
}

.picker-modal {
  width: 85%;
  max-height: 70vh;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
}

.picker-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.picker-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2C3E50;
}

.picker-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-text {
  font-size: 28rpx;
  color: #999;
  line-height: 1;
}

.picker-search {
  padding: 16rpx 20rpx;
  background: #F5F7FA;
  border-radius: 12rpx;
  font-size: 26rpx;
  margin-bottom: 16rpx;
}

.picker-list {
  max-height: 50vh;
}

.picker-item {
  padding: 20rpx;
  border-radius: 12rpx;
  background: #F9FAFC;
  margin-bottom: 12rpx;
}

.picker-item-tag {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  font-size: 18rpx;
  color: #fff;
  margin-bottom: 8rpx;
}

.picker-item-content {
  display: block;
  font-size: 24rpx;
  line-height: 1.5;
  color: #2C3E50;
  overflow: hidden;
  text-overflow: ellipsis;
}

.picker-item-time {
  display: block;
  font-size: 20rpx;
  color: #8E9AAF;
  margin-top: 6rpx;
}

.picker-empty {
  text-align: center;
  padding: 40rpx 0;
  font-size: 24rpx;
  color: #999;
}
