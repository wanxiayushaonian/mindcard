# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Gemini
GEMINI_API_KEY=

# Moonshot
MOONSHOT_API_KEY=

# Custom (any OpenAI-compatible endpoint)
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=
# Embedding (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
