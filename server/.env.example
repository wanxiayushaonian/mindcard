# PostgreSQL (docker-compose 变量插值来源；生产务必替换 POSTGRES_PASSWORD)
POSTGRES_USER=mindcard
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=mindcard
DATABASE_URL=postgresql+asyncpg://mindcard:mindcard@localhost:5432/mindcard
REDIS_URL=redis://localhost:6379/0
WECHAT_APPID=your_appid
WECHAT_SECRET=your_secret
JWT_SECRET=change-me-in-production
# 服务器级设置管理员白名单（逗号分隔的 username，留空则拒绝所有敏感操作）
# 例：ADMIN_USERNAMES=admin,ljb
ADMIN_USERNAMES=
# LLM Provider (default: claude)
DEFAULT_LLM_PROVIDER=deepseek
DEFAULT_LLM_MODEL=

# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Gemini
GEMINI_API_KEY=

# Moonshot
MOONSHOT_API_KEY=

# Custom (any OpenAI-compatible endpoint)
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=
# Embedding — provider: ollama (local) or openai (OpenAI-compatible API)
EMBEDDING_PROVIDER=ollama
# 使用 OpenAI 兼容的远程 API（例如硅基流动 SiliconFlow 的 BAAI/bge-m3，1024 维）时：
# EMBEDDING_PROVIDER=openai
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=your_key
# EMBEDDING_MODEL=BAAI/bge-m3
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
CORS_ORIGINS=*
