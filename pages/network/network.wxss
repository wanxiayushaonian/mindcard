/* pages/network/network.wxss */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
}

.nav-right {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.nav-icon-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-icon-text {
  font-size: 36rpx;
  color: #5A6A7A;
  line-height: 1;
}

/* Filter bar */
.filter-bar {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  padding: 10rpx 24rpx;
  background: var(--color-white);
  height: 68rpx;
  align-items: center;
}

.filter-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 24rpx;
  border-radius: 28rpx;
  font-size: 22rpx;
  margin-right: 16rpx;
  background: #F0F2F5;
  color: #666;
  flex-shrink: 0;
  line-height: 1.2;
}

.filter-active {
  background: var(--color-primary);
  color: #fff;
}

/* Canvas */
.canvas-container {
  flex: 1;
  position: relative;
  overflow: hidden;
}

.network-canvas {
  width: 100%;
  height: 100%;
}

/* Legend */
.legend {
  position: absolute;
  right: 24rpx;
  bottom: 32rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.legend-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
}

.legend-line {
  width: 32rpx;
  height: 4rpx;
  border-radius: 2rpx;
}

.legend-line-solid {
  background: rgba(148, 180, 200, 0.6);
}

.legend-line-dash {
  background: repeating-linear-gradient(
    to right,
    rgba(184, 169, 212, 0.5) 0rpx,
    rgba(184, 169, 212, 0.5) 6rpx,
    transparent 6rpx,
    transparent 10rpx
  );
  height: 4rpx;
}

.legend-text {
  font-size: 20rpx;
  color: #666;
}

/* Loading */
.loading-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(249, 250, 252, 0.7);
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* Tooltip */
.node-tooltip {
  position: absolute;
  background: var(--color-white);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  max-width: 400rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.tooltip-tag {
  display: inline-block;
  padding: 2rpx 14rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: #fff;
  align-self: flex-start;
}

.tooltip-keywords {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 6rpx;
}

.tooltip-kw {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: #fff;
}

.tooltip-label {
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

.tooltip-hint {
  font-size: 20rpx;
  color: var(--color-primary-dark);
}

.tooltip-shared {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 4rpx;
}

.tooltip-shared-label {
  font-size: 20rpx;
  color: #999;
  flex-shrink: 0;
}

.tooltip-shared-text {
  font-size: 20rpx;
  color: var(--color-primary-dark);
}
