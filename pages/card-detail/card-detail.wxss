/* pages/card-detail/card-detail.wxss */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
}

.nav-right {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
}

.nav-icon-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.heart-icon {
  font-size: 36rpx;
  color: #999;
  line-height: 1;
}

.heart-active {
  color: #E8A0A0;
}

.icon-more {
  display: flex;
  flex-direction: row;
  gap: 6rpx;
}
.dot {
  width: 8rpx;
  height: 8rpx;
  background: #666;
  border-radius: 50%;
}

/* Detail Card */
.detail-card {
  margin: 24rpx;
  padding: 32rpx;
  background: var(--color-white);
  border-radius: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.detail-card-tag {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #fff;
  margin-bottom: 20rpx;
}

.detail-card-keywords {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.detail-kw {
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
  font-size: 20rpx;
  color: #fff;
}

.detail-card-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 16rpx;
}

.detail-card-content {
  display: block;
  font-size: 30rpx;
  line-height: 1.8;
  color: var(--color-text);
  margin-bottom: 20rpx;
}

.detail-card-meta {
  display: flex;
  flex-direction: row;
  gap: 24rpx;
}

.detail-meta-item {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.detail-card-badges {
  margin-top: 16rpx;
}

.ai-badge {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  background: rgba(148, 180, 200, 0.12);
  border-radius: 12rpx;
  font-size: 22rpx;
  color: var(--color-primary-dark);
}

/* Action Bar */
.action-bar {
  display: flex;
  flex-direction: row;
  justify-content: space-around;
  padding: 24rpx 16rpx;
  margin: 0 24rpx;
  background: var(--color-white);
  border-radius: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.action-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(148, 180, 200, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-text {
  font-size: 26rpx;
  color: var(--color-primary-dark);
  font-weight: 700;
}

.action-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

/* Section */
.section {
  margin-top: 28rpx;
  padding: 0 24rpx;
}

.section-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

.section-count {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

/* Related Cards Scroll */
.related-scroll {
  white-space: nowrap;
  height: 220rpx;
}

.related-card {
  display: inline-block;
  width: 240rpx;
  height: 180rpx;
  padding: 20rpx;
  background: var(--color-white);
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  margin-right: 16rpx;
  vertical-align: top;
  box-sizing: border-box;
}

.related-card-content {
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  white-space: normal;
  margin-bottom: 12rpx;
}

.related-card-tag {
  font-size: 20rpx;
}

.related-add {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #D0D5DD;
  background: transparent;
  box-shadow: none;
}

.related-add-plus {
  font-size: 40rpx;
  color: #D0D5DD;
  line-height: 1;
  margin-bottom: 12rpx;
}

.related-add-text {
  font-size: 22rpx;
  color: #999;
}

/* Recommend Cards */
.recommend-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.recommend-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: var(--color-white);
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  gap: 16rpx;
}

.recommend-info {
  flex: 1;
  padding-left: 16rpx;
}

.recommend-content {
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-bottom: 8rpx;
}

.recommend-footer {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

.recommend-tag {
  font-size: 18rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  color: #fff;
}

.recommend-match {
  font-size: 18rpx;
  color: var(--color-text-secondary);
}

.recommend-btn {
  padding: 12rpx 24rpx;
  background: var(--color-primary);
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #fff;
  flex-shrink: 0;
}

/* Modal & Menu */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 100;
}

.more-menu {
  width: 100%;
  background: var(--color-white);
  border-radius: 32rpx 32rpx 0 0;
  padding: 36rpx 32rpx;
  padding-bottom: calc(36rpx + env(safe-area-inset-bottom));
}

.more-item {
  padding: 28rpx 0;
  text-align: center;
  font-size: 30rpx;
  color: var(--color-text);
  border-bottom: 1rpx solid #F0F2F5;
}

.more-item-danger {
  color: #E25D5D;
}

.more-item-cancel {
  color: var(--color-text-secondary);
  border-bottom: none;
  margin-top: 12rpx;
}

/* Confirm Dialog */
.confirm-dialog {
  width: 80%;
  background: var(--color-white);
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.confirm-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 20rpx;
}

.confirm-msg {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  text-align: center;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.confirm-actions {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
}

.confirm-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.confirm-cancel {
  background: #F0F2F5;
  color: #666;
}

.confirm-danger {
  background: #E25D5D;
  color: #fff;
}
