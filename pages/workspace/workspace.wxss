/* pages/workspace/workspace.wxss */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
}

.nav-right {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.nav-icon-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-icon-text {
  font-size: 36rpx;
  color: #5A6A7A;
  line-height: 1;
}

/* Grid */
.ws-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  padding: 24rpx;
  gap: 20rpx;
}

.ws-card {
  width: calc(50% - 10rpx);
  background: var(--color-white);
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  box-sizing: border-box;
}

.ws-icon {
  font-size: 48rpx;
  line-height: 1;
  margin-bottom: 8rpx;
}

.ws-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  line-height: 1.3;
}

.ws-count {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.ws-time {
  font-size: 20rpx;
  color: #C0C4CC;
}

/* Add card */
.ws-add {
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #D0D5DD;
  background: transparent;
  box-shadow: none;
  min-height: 200rpx;
}

.ws-add-icon {
  font-size: 48rpx;
  color: #D0D5DD;
  line-height: 1;
  margin-bottom: 8rpx;
}

.ws-add-text {
  font-size: 24rpx;
  color: #999;
}

/* Modal */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.create-modal {
  width: 85%;
  background: var(--color-white);
  border-radius: 28rpx;
  padding: 36rpx;
}

.modal-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  color: var(--color-text);
  margin-bottom: 28rpx;
}

.modal-input {
  padding: 20rpx 24rpx;
  background: #F5F7FA;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--color-text);
  margin-bottom: 24rpx;
}

.modal-section-label {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
}

/* Icon picker */
.icon-picker {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.icon-option {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F7FA;
  border-radius: 16rpx;
  font-size: 32rpx;
}

.icon-option-active {
  background: rgba(148, 180, 200, 0.2);
  box-shadow: 0 0 0 3rpx var(--color-primary);
}

/* Color picker */
.color-picker {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.color-option {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
}

.color-option-active {
  box-shadow: 0 0 0 4rpx var(--color-white), 0 0 0 7rpx var(--color-primary);
}

.modal-actions {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.modal-cancel {
  background: #F0F2F5;
  color: #666;
}

.modal-confirm {
  background: var(--color-primary);
  color: #fff;
}

/* Confirm dialog */
.confirm-dialog {
  width: 80%;
  background: var(--color-white);
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
}

.confirm-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 20rpx;
}

.confirm-msg {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  text-align: center;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.confirm-actions {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
}

.confirm-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.confirm-cancel {
  background: #F0F2F5;
  color: #666;
}

.confirm-danger {
  background: #E25D5D;
  color: #fff;
}
