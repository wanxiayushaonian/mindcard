/* pages/profile/profile.wxss */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
}

/* Stats Grid - 5 columns */
.stats-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin: 24rpx;
  background: var(--color-white);
  border-radius: 24rpx;
  padding: 24rpx 8rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.stat-item {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 0;
}

.stat-number {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-primary-dark);
}

.stat-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

/* Settings Section */
.settings-section {
  margin: 0 24rpx 24rpx;
}

.settings-section-title {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
  padding-left: 8rpx;
}

.settings-list {
  background: var(--color-white);
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.settings-item {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #F5F7FA;
}

.settings-item:last-child {
  border-bottom: none;
}

.settings-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.settings-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}

.icon-backup {
  background: rgba(148, 180, 200, 0.12);
  color: var(--color-primary-dark);
}
.icon-clear {
  background: rgba(226, 93, 93, 0.1);
  color: #E25D5D;
}
.icon-chat-records {
  background: rgba(184, 169, 212, 0.12);
  color: #B8A9D4;
}
.icon-agent {
  background: rgba(196, 215, 178, 0.2);
  color: #7DA66A;
}
.icon-color {
  background: rgba(212, 181, 208, 0.15);
  color: #B88FB3;
}
.icon-walk {
  background: rgba(160, 184, 200, 0.15);
  color: #7A9BB0;
}
.icon-ai-tone {
  background: rgba(148, 180, 200, 0.12);
  color: var(--color-primary-dark);
}
.icon-ai-direction {
  background: rgba(232, 201, 160, 0.2);
  color: #C4955A;
}
.icon-auto {
  background: rgba(148, 180, 200, 0.12);
  color: var(--color-primary-dark);
}
.icon-help {
  background: rgba(148, 180, 200, 0.12);
  color: var(--color-primary-dark);
}

.settings-text {
  font-size: 28rpx;
  color: var(--color-text);
}

.danger-text {
  color: #E25D5D;
}

.settings-right-info {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

.settings-value {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.settings-count {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.settings-arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid #C0C4CC;
  border-right: 3rpx solid #C0C4CC;
  transform: rotate(45deg);
}

.color-preview {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
}

/* Toggle */
.toggle {
  width: 80rpx;
  height: 44rpx;
  border-radius: 22rpx;
  background: #E0E5EA;
  padding: 4rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  transition: background 0.3s;
}

.toggle-on {
  background: var(--color-primary);
  justify-content: flex-end;
}

.toggle-dot {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* Footer */
.profile-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
  gap: 8rpx;
}

.footer-text {
  font-size: 22rpx;
  color: #C0C4CC;
}

.footer-subtext {
  font-size: 20rpx;
  color: #D0D5DD;
}

/* Modal */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.confirm-dialog {
  width: 80%;
  background: var(--color-white);
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
}

.confirm-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 20rpx;
}

.confirm-msg {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  text-align: center;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.confirm-actions {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
}

.confirm-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.confirm-cancel {
  background: #F0F2F5;
  color: #666;
}

.confirm-danger {
  background: #E25D5D;
  color: #fff;
}

.modal-input-field {
  padding: 20rpx;
  background: #F5F7FA;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--color-text);
  margin-bottom: 24rpx;
}

.icon-api-key {
  background: rgba(232, 201, 160, 0.2);
  color: #C4955A;
}

.icon-model {
  background: rgba(184, 169, 212, 0.12);
  color: #B8A9D4;
}
