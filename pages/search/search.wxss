page { height: 100vh; display: flex; flex-direction: column; background: #F9FAFC; }
.search-bar { display: flex; flex-direction: row; align-items: center; padding: 16rpx 24rpx; gap: 16rpx; background: #fff; }
.search-input { flex: 1; padding: 16rpx 24rpx; background: #F5F7FA; border-radius: 24rpx; font-size: 28rpx; }
.search-cancel { font-size: 26rpx; color: #7A9BB0; }
.results-section { padding: 16rpx 24rpx; }
.results-count { display: block; font-size: 22rpx; color: #8E9AAF; margin-bottom: 16rpx; }
.results-list { display: flex; flex-direction: column; gap: 16rpx; }
.result-card { padding: 24rpx; background: #fff; border-radius: 16rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.result-tag { display: inline-block; padding: 4rpx 14rpx; border-radius: 8rpx; font-size: 18rpx; color: #fff; margin-bottom: 12rpx; }
.result-title { display: block; font-size: 28rpx; font-weight: 600; color: #2C3E50; margin-bottom: 8rpx; }
.result-content { display: block; font-size: 26rpx; line-height: 1.5; color: #666; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; margin-bottom: 8rpx; }
.result-time { font-size: 20rpx; color: #8E9AAF; }
.result-chat { border-left: 6rpx solid #B8A9D4; }
.result-chat-title { display: block; font-size: 28rpx; font-weight: 600; color: #2C3E50; margin-bottom: 6rpx; }
.result-chat-time { font-size: 22rpx; color: #8E9AAF; }
.empty-state { display: flex; align-items: center; justify-content: center; padding: 80rpx 0; }
.empty-text { font-size: 26rpx; color: #999; }
.search-hint { text-align: center; padding: 120rpx 40rpx; font-size: 26rpx; color: #C0C4CC; }
