page { height: 100vh; display: flex; flex-direction: column; background: #F9FAFC; }
.records-list { padding: 16rpx 24rpx; }
.record-item { padding: 24rpx; background: #fff; border-radius: 16rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); margin-bottom: 16rpx; border-left: 6rpx solid #B8A9D4; }
.record-header { display: flex; flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.record-title { font-size: 28rpx; font-weight: 600; color: #2C3E50; flex: 1; }
.record-delete { font-size: 22rpx; color: #E25D5D; padding: 4rpx 12rpx; }
.record-time { font-size: 22rpx; color: #8E9AAF; display: block; margin-bottom: 6rpx; }
.record-count { font-size: 22rpx; color: #7A9BB0; display: block; margin-bottom: 12rpx; }
.record-preview { padding: 16rpx; background: #F5F7FA; border-radius: 10rpx; }
.record-preview-text { font-size: 24rpx; line-height: 1.5; color: #666; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.empty-state { display: flex; align-items: center; justify-content: center; padding: 120rpx 0; }
.empty-text { font-size: 26rpx; color: #999; }
