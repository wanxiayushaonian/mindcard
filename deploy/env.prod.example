# MindCard 生产环境变量模板
# 用法: cp deploy/env.prod.example server/.env && vim server/.env
# 注意: server/.env 已被 .gitignore 忽略，绝不要提交到 git

# ── PostgreSQL（docker-compose 变量插值来源，务必改强随机密码）──
POSTGRES_USER=mindcard
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_32CHARS
POSTGRES_DB=mindcard
DATABASE_URL=postgresql+asyncpg://mindcard:REPLACE_WITH_STRONG_RANDOM_32CHARS@localhost:5432/mindcard
REDIS_URL=redis://localhost:6379/0

# ── 认证安全 ──
# JWT 签名密钥（>=32 字符，用 openssl rand -hex 32 生成）
JWT_SECRET=REPLACE_WITH_32PLUS_CHARS_RANDOM
# 服务器级设置管理员白名单（逗号分隔用户名；留空则全部敏感接口 403）
ADMIN_USERNAMES=
# 生产必须收紧，勿用 *（逗号分隔可加多个）
CORS_ORIGINS=https://mindcard.online

# ── LLM（至少配一个 provider）──
# 默认 provider（claude / deepseek / openai / gemini / moonshot / custom）
DEFAULT_LLM_PROVIDER=claude
DEFAULT_LLM_MODEL=
# 轻量任务（标题/关键词抽取）默认跟随主 provider，也可单独指定
EXTRACTION_LLM_PROVIDER=
EXTRACTION_LLM_MODEL=

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Gemini
GEMINI_API_KEY=
# Moonshot
MOONSHOT_API_KEY=
# Custom (任意 OpenAI 兼容端点)
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=

# ── Embedding：二选一 ──
# A) 远程 OpenAI 兼容 API（推荐，无需自建 Ollama；bge-m3 = 1024 维，与 DB 一致）
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
# B) 本地 Ollama（若走此方案，把上面注释掉并开启下面两行）
# EMBEDDING_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# ── 微信登录（可选，未配置则仅用户名/密码登录）──
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_WEB_APPID=
WECHAT_WEB_SECRET=

# ── 网页搜索（可选）──
WEB_SEARCH_PROVIDER=duckduckgo   # duckduckgo / brave / tavily / searxng / jina / kagi
WEB_SEARCH_API_KEY=
WEB_SEARCH_BASE_URL=
WEB_SEARCH_PROXY=

# ── 速率限制（默认值即可）──
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_AI_MAX=20
# RATE_LIMIT_RAG_MAX=10
# RATE_LIMIT_WS_MAX=60

# ── 运行时 ──
DEBUG=false
LOG_LEVEL=INFO
